<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Здесь будет цитата"
            android:textSize="18sp"
            android:padding="8dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edit_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите новую цитату"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/button_add"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Добавить" />

            <Button
                android:id="@+id/button_random"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Случайная" />

            <Button
                android:id="@+id/button_show_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Показать все" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/button_sync"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Синхронизировать" />

            <Button
                android:id="@+id/button_switch_user"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Сменить пользователя" />

            <Button
                android:id="@+id/button_clear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Очистить поле" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус"
            android:textColor="#888888"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>